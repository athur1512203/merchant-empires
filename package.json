{
  "name": "merchant-empires",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assets:prepare": "node scripts/prepare-game-assets.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "server:dev": "tsx watch server/src/index.ts",
    "server:start": "node server/dist/index.mjs",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p server/tsconfig.json",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "node --env-file=server/.env node_modules/prisma/build/index.js migrate deploy --schema server/prisma/schema.prisma",
    "test:neon": "node server/tests/run-neon-tests.mjs",
    "server:build": "tsc -p server/tsconfig.build.json && node server/build.mjs",
    "verify:render": "node scripts/verify-render-clean.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vitejs/plugin-react": "latest",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "framer-motion": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vite": "latest",
    "zod": "^4.6.7",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "latest",
    "esbuild": "^0.28.2",
    "postcss": "latest",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": "24.x"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  }
}
